[Unit]
Description=Sunshine isolated game streaming session (headless Hyprland on seat1)
After=network-online.target systemd-user-sessions.service
Wants=network-online.target

[Service]
Type=simple
User=sergiom
# PAMName=login + XDG_SEAT=seat1 makes pam_systemd register a logind session on
# seat1 (no VT — non-seat0 seats have none, so the session is active instantly
# and never competes with the local seat0 session). The compositor needs this
# session for libseat/libinput to enumerate seat1 input devices.
PAMName=login
Environment=XDG_SEAT=seat1
# Session type MUST NOT be wayland/x11: on every GDM login,
# on_stop_conflicting_session() (gdm-manager.c) terminates ALL of the user's
# other active *graphical* logind sessions — that's what killed this
# compositor and produced the greeter's "there is already an open session"
# nag. GDM's filter (_systemd_session_is_graphical, gdm-common.c) only looks
# at the session TYPE (wayland/x11/mir), not the class, so registering as
# "unspecified" makes GDM ignore this session entirely. logind device access
# (libseat TakeControl) does not depend on the type — but it DOES depend on
# the class: logind (systemd 261) rejects TakeDevice for background-class
# sessions ("Session class doesn't support taking device control"), which
# leaves aquamarine with no GPU and Hyprland aborts at startup. The class must
# stay "user". init.sh exports XDG_SESSION_TYPE=wayland for the app tree;
# session.sh must NOT, or libseat's SetType(getenv(XDG_SESSION_TYPE)) would
# retype the logind session to wayland and re-expose it to GDM's killer.
Environment=XDG_SESSION_TYPE=unspecified
Environment=XDG_SESSION_CLASS=user
Environment=XDG_SESSION_DESKTOP=Hyprland
UnsetEnvironment=DISPLAY WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE
ExecStart=/home/sergiom/.config/hypr/sunshine-seat1/session.sh
Restart=on-failure
RestartSec=5

# No [Install] section on purpose: this unit must NOT be enabled at boot.
#
# Started at boot, it opens a logind session for the user before anyone has
# logged in, and GDM's greeter then refuses the login with "there is already a
# session running" (it offers to switch to the existing one instead). The
# session type dodge below keeps GDM from *killing* this session, but the
# greeter still counts it when deciding whether the user is already logged in.
#
# Instead conf/autostart.lua starts it from the seat0 Hyprland session, right
# after login (toggle.sh autostart -> systemctl start, passwordless via the
# polkit rule). Same session, same isolation, but it only exists while the
# desktop does — so the greeter never sees it.
