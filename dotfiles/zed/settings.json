// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
	// "show_completions_on_input": false,
 "cli_default_open_behavior": "existing_window",
 "bottom_dock_layout": "contained",
 "project_panel": {
  "dock": "left"
 },
 "collaboration_panel": {
  "dock": "right"
 },
 "git_panel": {
  "dock": "right"
 },
 "agent_servers": {
  "claude-acp": {
   "type": "registry"
  }
 },
 "edit_predictions": {
  "ollama": {
   "model": "qwen3-coder:latest"
  },
  "provider": "zed"
 },
 "context_servers": {
  "serena-context-server": {
   "enabled": true,
   "remote": false,
   "settings": {}
  }
 },
 "agent": {
		"dock": "left",
  "tool_permissions": {
   "default": "allow"
  },
  "inline_assistant_model": {
			"provider": "google",
			"model": "gemini-3-flash-preview"
		},
		"default_model": {
			"enable_thinking": true,
   "provider": "ollama",
			"model": "deepseek-r1:8b"
		}
	},
	"ui_font_size": 18,
	"buffer_font_size": 18,
	"hard_tabs": true,
	"tab_size": 4,
	"outline_panel": {
		"dock": "right",
  "indent_size": 10
	},
	"theme": {
		"mode": "system",
		"light": "CodeSandbox",
		"dark": "One Black"
	},
	"languages": {
		"HTML": {
			"prettier": {
				"allowed": true,
				"parser": "go-template",
				"plugins": ["prettier-plugin-go-template"]
			}
		},
		"YAML": {
			"tab_size": 4,
			"hard_tabs": true
		},
		"Shell Script": {
			"tab_size": 4,
			"hard_tabs": true,
			"format_on_save": "on",
			"formatter": {
				"external": {
					"command": "shfmt",
					// Change `--indent 2` to match your preferred tab_size
					"arguments": [
						"--filename",
						"{buffer_path}",
						"--indent",
						"4"
					]
				}
			}
		}
	},
	"language_overrides": {
		"YAML": {
			"tab_size": 4,
			"hard_tabs": true
		}
	}
}
