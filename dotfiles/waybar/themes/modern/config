{
    // General Settings
    "layer": "top",
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,
    "include": [
        "~/.config/hypr/user_settings/waybar-quicklinks.json",
        "~/.config/waybar/modules.json"
    ],
    // Modules Left
    "modules-left": [
        "custom/appmenu",
        "hyprland/workspaces",
        "wlr/taskbar",
        //"group/quicklinks",
        "hyprland/window",
        "custom/empty"
    ],
    // Modules Center
    "modules-center": [
        "clock",
        "custom/empty"
    ],
    "tray": {
        "icon-size": 18,
        "spacing": 5
    },
    // Modules Right
    "modules-right": [
        "group/future-media",
        "group/future-hardware",
        "group/future-connectivity",
        "group/future-system"
    ],
    "group/future-hardware": {
        "orientation": "horizontal",
        "modules": [
            "temperature",
            "memory",
            "cpu"
        ],
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-memory",
            "transition-left-to-right": false
        }
    },
    "group/future-media": {
        "orientation": "horizontal",
        "modules": [
            "custom/waybar-music",
            "pulseaudio",
            "backlight"
        ]
    },
    "group/future-connectivity": {
        "orientation": "horizontal",
        "modules": [
            "network",
            "bluetooth"
        ]
    },
    "group/future-system": {
        "orientation": "horizontal",
        "modules": [
            "battery",
            "tray",
            "custom/notification",
            "custom/exit"
        ]
    }
}
