* {
    background: {{colors.background.default.hex}};
    background-alt: {{colors.surface_container_low.default.hex}};
    foreground: {{colors.on_surface.default.hex}};
    on-surface: {{colors.on_surface.default.hex}};
    selected: {{colors.primary_container.default.hex}};
    active: {{colors.secondary_container.default.hex}};
    urgent: {{colors.error.default.hex}};
    primary: {{colors.primary.default.hex}};
    secondary: {{colors.secondary.default.hex}};
    border-color: {{colors.primary.default.hex}};
}
